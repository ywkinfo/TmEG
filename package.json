{
  "name": "trademark-exam-harness",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "content:inventory": "python -m pipeline.build_inventory",
    "content:toc": "python -m pipeline.build_toc",
    "content:images": "python -m pipeline.build_images",
    "content:build": "python -m pipeline.build_content",
    "content:qa": "python -m pipeline.qa_content",
    "content:export-nlm": "python -m pipeline.export_notebooklm",
    "content:prepare": "npm run content:inventory && npm run content:toc && npm run content:images && npm run content:build && npm run content:qa",
    "web:sync": "python -m pipeline.sync_web_generated",
    "web:prepare": "npm run content:prepare && npm run web:sync",
    "web:serve": "python -m http.server 4317 --directory web",
    "test": "python -m pytest tests/ -v"
  }
}
